{
  "_readme": "LTX-2.3 22B (dev, GGUF) Text-zu-Video+Audio fuer SeriesAI. LTX-2.3 ist ein Audio-Video-Modell: Video- und Audio-Latent werden verbunden gesampelt (LTXVConcatAVLatent) und danach getrennt dekodiert. width/height muessen durch 32 teilbar sein, frame_count = 8*n+1, 24 fps. Platzhalter ${seriesai.*} ersetzt das Backend.",
  "1": {"class_type": "UnetLoaderGGUF", "inputs": {"unet_name": "ltx-2.3-22b-dev-Q4_K_M.gguf"}},
  "2": {"class_type": "DualCLIPLoaderGGUF", "inputs": {"clip_name1": "gemma-3-12b-it-qat-UD-Q4_K_XL.gguf", "clip_name2": "ltx-2.3-22b-dev_embeddings_connectors.safetensors", "type": "ltxv"}},
  "3": {"class_type": "VAELoader", "inputs": {"vae_name": "ltx-2.3-22b-dev_video_vae.safetensors"}},
  "3b": {"class_type": "VAELoader", "inputs": {"vae_name": "ltx-2.3-22b-dev_audio_vae.safetensors"}},
  "4": {"class_type": "CLIPTextEncode", "inputs": {"text": "${seriesai.prompt}", "clip": ["2", 0]}},
  "5": {"class_type": "CLIPTextEncode", "inputs": {"text": "${seriesai.negative_prompt}", "clip": ["2", 0]}},
  "6": {"class_type": "LTXVConditioning", "inputs": {"positive": ["4", 0], "negative": ["5", 0], "frame_rate": "${seriesai.fps}"}},
  "7": {"class_type": "EmptyLTXVLatentVideo", "inputs": {"width": "${seriesai.width}", "height": "${seriesai.height}", "length": "${seriesai.frame_count}", "batch_size": 1}},
  "8": {"class_type": "LTXVEmptyLatentAudio", "inputs": {"frames_number": "${seriesai.frame_count}", "frame_rate": "${seriesai.fps}", "batch_size": 1, "audio_vae": ["3b", 0]}},
  "9": {"class_type": "LTXVConcatAVLatent", "inputs": {"video_latent": ["7", 0], "audio_latent": ["8", 0]}},
  "10": {"class_type": "LTXVScheduler", "inputs": {"steps": 20, "max_shift": 2.05, "base_shift": 0.95, "stretch": true, "terminal": 0.1, "latent": ["9", 0]}},
  "11": {"class_type": "CFGGuider", "inputs": {"model": ["1", 0], "positive": ["6", 0], "negative": ["6", 1], "cfg": 4.0}},
  "12": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
  "13": {"class_type": "RandomNoise", "inputs": {"noise_seed": "${seriesai.seed}"}},
  "14": {"class_type": "SamplerCustomAdvanced", "inputs": {"noise": ["13", 0], "guider": ["11", 0], "sampler": ["12", 0], "sigmas": ["10", 0], "latent_image": ["9", 0]}},
  "15": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["14", 0]}},
  "16": {"class_type": "VAEDecodeTiled", "inputs": {"samples": ["15", 0], "vae": ["3", 0], "tile_size": 512, "overlap": 64, "temporal_size": 32, "temporal_overlap": 8}, "_note": "Gekachelter Decode, damit 6 GB VRAM reichen."},
  "17": {"class_type": "LTXVAudioVAEDecode", "inputs": {"samples": ["15", 1], "audio_vae": ["3b", 0]}},
  "18": {"class_type": "CreateVideo", "inputs": {"images": ["16", 0], "fps": "${seriesai.fps}", "audio": ["17", 0], "codec": "h264"}},
  "19": {"class_type": "SaveVideo", "inputs": {"video": ["18", 0], "filename_prefix": "${seriesai.output_prefix}", "format": "mp4"}}
}
